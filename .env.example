# Gmail (Nodemailer) — use App Password, not your normal Gmail password
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where contact form messages are delivered
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=admin123

# MongoDB — use direct connection if mongodb+srv fails on your network (Windows DNS)
DATABASE=mongodb://username:password@host1:27017,host2:27017,host3:27017/dbname?ssl=true&authSource=admin&retryWrites=true&w=majority

# JWT secret for auth tokens
JWT_SECRET=change-this-to-a-random-secret

# API server port (must match vite proxy)
PORT=5000

# Cloudinary — images saved to cloud (avatars + products)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
